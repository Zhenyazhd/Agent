# Custom RPC URLs (optional, defaults to public RPCs)
ETH_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
AVALANCHE_RPC_URL=
