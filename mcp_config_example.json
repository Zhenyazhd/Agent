{
  "mcpServers": {
    "foundry": {
      "command": "node",
      "args": ["/path/to/agent/foundry-mcp-server/dist/index.js"],
      "env": {
        "RPC_URL": "https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY",
        "PRIVATE_KEY": "0x...",
        "YOUR_ALCHEMY_API_KEY": "YOUR_ALCHEMY_API_KEY"
      }
    },
    "solodit": {
      "command": "node",
      "args": ["/path/to/agent/mcp_solodit_db/dist/index.js"],
      "env": {
        "SOLODIT_API_KEY": "your_solodit_api_key_here"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/agent/WORKSPACE"],
      "env": {}
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-postgres"],
      "env": { "DATABASE_URL": "postgresql://user:password@localhost:5432/llm_agent" }
    },
    "OpenZeppelinSolidityContracts": {
      "type": "streamable-http",
      "url": "https://mcp.openzeppelin.com/contracts/solidity/mcp"
    },
    "slither-mcp": {
      "command": "uvx --from git+https://github.com/trailofbits/slither-mcp slither-mcp"
    },
    "blockscout": {
      "type": "streamable-http",
      "url": "https://mcp.blockscout.com/mcp",
      "timeout": 180000
    },
    "largefile": {
      "command": "uvx",
      "args": ["--from", "largefile", "largefile-mcp"]
    },
    "loop-decoder": {
      "command": "npx",
      "args": ["tsx", "/path/to/agent/loop_decoder/src/mcp-server.ts"],
      "env": {
        "ETHERSCAN_API_KEY": "your_etherscan_api_key_here",
        "ETH_RPC_URL": "https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
      }
    }
  }
}
